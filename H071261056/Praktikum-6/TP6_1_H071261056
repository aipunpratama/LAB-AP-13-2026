def tambah_buku (inventaris, judul, penulis, harga, stok) :
    daftar = {
        "judul": judul,
         "penulis" : penulis,
         "harga" : harga, 
         "stok" :stok
    }
    inventaris.append(daftar)
    print (f"buku '{judul}' berhasil ditambahkan!")

def cari_buku(inventaris, kata_kunci):
    hasil = []
    kata_kunci = kata_kunci.lower()

    for i in inventaris :
        if kata_kunci in i["judul"].lower():
            hasil.append(i)
    if len(hasil) == 0:
        print ("pesan tidak ditemukan.")        
    else :
        print (f"ditemukan {len(hasil)} buku :")
        for nomor, buku in enumerate (hasil, start = 1):
            print (f"{nomor}. {buku['judul']} - {buku['penulis']} | Rp{buku['harga']} | stok : {buku['stok']}")

def update_stok (inventaris,judul,jumlah) :
    ditemukan = False 
    for i in inventaris :
        if judul.lower() == i["judul"].lower():
            ditemukan = True 
            stok_baru = i["stok"] + jumlah
            if stok_baru < 0 :
                print ("pesan gagal")
            else :
                i["stok"] = stok_baru
                if jumlah >= 0:
                    print (f"Stok '{i['judul']}' bertambah {jumlah}. Stok kosong : {stok_baru}")
                else :
                    print (f"Stok '{['judul']} berkurang {abs(jumlah)}. Stok sekarang : {stok_baru}")
            break
    if not ditemukan :
        print (f"Error : buku '{judul}' tidak ditemukan!")

def ringkasan_inventaris (inventaris):
    total_stok = 0
    total_nilai = 0
    termahal =(inventaris[0])

    for i in inventaris :
        total_stok += i["stok"]
        total_nilai += i["harga"]*i["stok"]
        if i["harga"] > termahal["harga"] :
            termahal = i

    print ("="*40)
    print ("RINGKASAN INVENTARIS BOOKNEST")
    print ("="*40)
    print (f"Jumlah jenis buku : {len(inventaris)}")
    print (f"Total seluruh {total_stok}")  
    print (f"Total nilai aset : Rp{total_nilai}")
    print (f"Buku termahal : {termahal['judul']}")
    print ("="*40)


