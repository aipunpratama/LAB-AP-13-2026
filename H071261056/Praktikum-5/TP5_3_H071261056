ALFABET = "abcdefghijklmnopqrstuvwxyz"


def cek_sandi(ch, k):
    posisi = ALFABET.find(ch.lower())

    if posisi == -1:
        return ch

    posisi_baru = (posisi + k) 
    karakter_baru = ALFABET[posisi_baru]

    if ch.isupper():
        return karakter_baru.upper()
    else:
        return karakter_baru.lower()


def mesin_enkripsi(teks, k):
    hasil = ""
    for ch in teks:
        hasil += cek_sandi(ch, k)
    return hasil


def mesin_dekripsi(teks, k):
    return mesin_enkripsi(teks, -k)


def retas_sandi(sandi, kata_kunci):
    hasil_retas = []

    for k in range(0,26):
        pesan_dekripsi = mesin_dekripsi(sandi, k)

        if pesan_dekripsi.lower().find(kata_kunci.lower()) != -1:
            hasil_retas.append((k, pesan_dekripsi))

    return hasil_retas


pesan_tersita = input("Masukkan pesan tersita (enkripsi Caesar): ")
kata_kunci = input("Masukkan kata kunci target: ")

output = retas_sandi(pesan_tersita, kata_kunci)

print("\nOutput Deskripsi:", output)