def bersihkan_teks (teks) :
    huruf = "abcdefghijklmnopqrstuvwxyz"
    hasil = ""
    for i in teks :
        if i.lower() in huruf :
            hasil += i.lower()
    return hasil

def cek_palinrome (teks) :
    teks_terbalik = "".join(reversed(teks))
    if teks == teks_terbalik :
        return (True,-1)
    else :
        for i in range (len(teks)) :
            if teks[i] != teks_terbalik [i] :
                return (False, i)

def inti_palinrome (teks) :
    teks_bersih = bersihkan_teks (teks) 
    terpanjang = ""
    max_terpanjang = 0 
    indeks_awal_terpanjang = 0

    for i in range (len(teks_bersih)) :
        for j in range (i + 1, len(teks_bersih) + 1) :
            potongan = teks_bersih [i:j]
            status, _ = cek_palinrome(potongan)
            if status and len(potongan) > max_terpanjang :
                terpanjang = potongan
                max_terpanjang = len(potongan)
                indeks_awal_terpanjang = i

    return {"teks" : terpanjang, "panjang" : max_terpanjang, "indeks_awal" : indeks_awal_terpanjang} 
prasasti = input("Masukkan teks prasasti: ")
teks_bersih = bersihkan_teks(prasasti)
print ("teks bersih :", teks_bersih)

hasil = inti_palinrome(prasasti)
print ("Output Terharap :", hasil)

                        