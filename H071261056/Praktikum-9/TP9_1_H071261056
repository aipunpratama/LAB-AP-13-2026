class pemain :
    def __init__(self,nama,id_pemain,role,nilai_kill,nilai_assist,nilai_objective):
        self.nama = nama
        self.id_pemain = id_pemain
        self.role = role
        self.nilai_kill = nilai_kill
        self.nilai_assist = nilai_assist
        self.nilai_objective = nilai_objective

    def hitung_skor_akhir(self):
        skor_akhir = (0.3 * self.nilai_kill) + (0.3 * self.nilai_assist) + (0.3 * self.nilai_objective)
        return skor_akhir
    
    def status_peforma(self):
        return "Unggul" if self.hitung_skor_akhir() >=60 else "Perlu Evaluasi"

    def tampilkan_data(self,nomor):
        skor = self.hitung_skor_akhir()
        status = self.status_peforma()
        print (f"| {nomor:<3} | {self.nama:<10} | {self.id_pemain:<12} | {self.role:<10} | {skor:<12.2f} | {status:<12} |")

def input_teks (pesan):
    while True :
        teks = input(pesan).strip()
        if teks =="":
            print("Input tidak boleh kosong. Silahkan coba lagi.")
        else :
            return teks

def input_angka(pesan):
    while True :
        try :
            angka = float(input(pesan))
            if angka <0 or angka >100:
                print ("Nilai harus antara 0-100.Silahkan coba lagi.")
            else : 
                return angka
        except ValueError :
            print ("Input harus berupa angka.Silahkan coba lagi.")

def Jumlah(pesan):
    while True :
        try :
            jumlah = int(input(pesan))
            if jumlah <=0:
                print ("Jumlah pemain harus lebih dari 0. Silahkan coba lagi.")
            else :
                return jumlah
        except ValueError :
            print ("Input harus berupa bilangan bulat. Silahkan coba lagi.")

